# Karen Ultra — Environment Variables
# Copy this file to .env and fill in all values before running.
# Never commit .env to version control.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:5173
API_URL=http://localhost:8080

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# ─── AI — Primary (Gemini) ────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── AI — Fallback (Groq) ────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# GitHub Copilot SDK. Requires a Copilot-enabled GitHub account.
# Leave blank to use the signed-in Copilot CLI account. Classic ghp_ tokens are unsupported.
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL_ID=
# Defaults to the Copilot CLI home directory (~/.copilot).
COPILOT_BASE_DIR=

# AI routing config
AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-2.0-flash
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=llama-3.3-70b-versatile

# ─── Voice — ElevenLabs ───────────────────────────────────────────────────────
# Get from: https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# Voice ID for the confirmed female voice (Karen)
ELEVENLABS_FEMALE_VOICE_ID=
# Set to true once you have confirmed the voice sounds correct
VOICE_FEMALE_CONFIRMED=false
VOICE_LANGUAGE=en-IN

# ─── Meta (WhatsApp + Instagram) ─────────────────────────────────────────────
# Get from: https://developers.facebook.com -> Your App
META_APP_ID=
META_APP_SECRET=
# A random string you choose — must match what you set in the Meta webhook config
META_VERIFY_TOKEN=
# Disable polling on serverless hosts; Meta webhooks trigger replies there
INSTAGRAM_AUTO_REPLY_POLLING_ENABLED=true
# From: WhatsApp -> Getting Started -> Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# System User access token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# From: Instagram -> Basic Display -> Instagram App ID (for DM webhook)
INSTAGRAM_ACCOUNT_ID=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# ─── Google Classroom ─────────────────────────────────────────────────────────
GOOGLE_CLASSROOM_ENABLED=true
GOOGLE_CLASSROOM_SCOPES=https://www.googleapis.com/auth/classroom.courses.readonly https://www.googleapis.com/auth/classroom.coursework.me.readonly https://www.googleapis.com/auth/classroom.announcements.readonly https://www.googleapis.com/auth/classroom.rosters
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLASSROOM_SYNC_ENABLED=true
GOOGLE_CLASSROOM_SYNC_INTERVAL=900000
GOOGLE_CLASSROOM_TIMEZONE=Asia/Kolkata

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# A random string for validating webhook requests
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs of authorized owners
TELEGRAM_OWNER_USER_IDS=

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-32-byte-hex-secret
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
APP_SECRET=replace-with-long-random-secret
JWT_SECRET=replace-with-another-long-secret

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
