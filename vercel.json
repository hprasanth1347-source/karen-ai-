{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --include=dev --workspace=@karen/web --workspace=@karen/api",
  "buildCommand": "npm run build --workspace=@karen/web && rm -rf dist && cp -r apps/web/dist dist",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/v1/cron/morning-briefing",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/v1/cron/companion-tick",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/v1/cron/classroom-sync",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api?__path=/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__path=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
