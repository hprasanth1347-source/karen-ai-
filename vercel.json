{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --include=dev --workspace=@karen/web --workspace=@karen/api",
  "buildCommand": "npm run build --workspace=@karen/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api?__path=/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__path=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
